+//  OpenCode patch: map a motion event's button state to a GHOST button.
+//  This lets the touch/pointer pipeline emit distinct LMB/RMB/MMB events from
+//  an actual hardware mouse instead of always reporting left-click.
+static GHOST_TButton buttonPressFromState(int32_t buttonState) {
+    if (buttonState & AMOTION_EVENT_BUTTON_TERTIARY) {
+        return GHOST_kButtonMaskMiddle;
+    }
+    if (buttonState & AMOTION_EVENT_BUTTON_SECONDARY) {
+        return GHOST_kButtonMaskRight;
+    }
+    if (buttonState & AMOTION_EVENT_BUTTON_PRIMARY) {
+        return GHOST_kButtonMaskLeft;
+    }
+    return GHOST_kButtonMaskLeft;
+}
